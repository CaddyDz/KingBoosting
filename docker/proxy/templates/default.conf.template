# Development stand-in for Traefik (see docs/adr/0001): one origin, routed by path.
# Upstreams are resolved per request, so the stack starts even before Nuxt or Reverb exist.

map $http_upgrade $connection_upgrade {
	default upgrade;
	"" close;
}

server {
	listen ${NGINX_PORT} default_server;
	server_name _;

	server_tokens off;
	client_max_body_size 20m;

	resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

	proxy_http_version 1.1;
	proxy_set_header Host $http_host;
	proxy_set_header X-Real-IP $remote_addr;
	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	proxy_set_header X-Forwarded-Proto $scheme;
	proxy_set_header X-Forwarded-Host $http_host;
	proxy_set_header X-Forwarded-Port $server_port;
	# Set here, once: a location with its own proxy_set_header would drop every header above
	proxy_set_header Upgrade $http_upgrade;
	proxy_set_header Connection $connection_upgrade;

	# Laravel: the API, Sanctum's CSRF cookie, channel auth, Stripe webhooks, the health check
	location ~ ^/(api|sanctum|broadcasting|stripe|up)(/|$) {
		set $laravel http://web:8080;
		proxy_pass $laravel;
		proxy_read_timeout 3600s;
	}

	# Reverb: the WebSocket only. Its /apps HTTP API stays on the internal network.
	location /app/ {
		set $reverb http://reverb:8080;
		proxy_pass $reverb;
		proxy_read_timeout 3600s;
	}

	# Everything else: Nuxt, including its dev server's HMR socket
	location / {
		set $nuxt http://frontend:3000;
		proxy_pass $nuxt;
	}
}
