APP_NAME="King Boosting"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The one public origin: the proxy routes /api, /sanctum, /broadcasting and /stripe here, the rest to Nuxt
APP_URL=http://localhost:8000
FRONTEND_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=kingboosting
DB_USERNAME=kingboosting
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:8000

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@kingboosting.test"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb app credentials. The key is public (the browser sends it); the secret signs server-to-server calls.
REVERB_APP_ID=kingboosting
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where Laravel sends broadcasts (the reverb service on the internal network)
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Where the Reverb server listens inside its container
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Origins allowed to open a WebSocket, comma-separated
REVERB_ALLOWED_ORIGINS=localhost:8000

# Stripe test keys only: the demo never takes real payments
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Password of the seeded demo accounts (admin@, moderator@, booster@, customer@kingboosting.test)
DEMO_PASSWORD=password
