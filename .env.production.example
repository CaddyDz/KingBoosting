# Production settings for compose.prod.yaml: copy to .env.production on the server (docs/deploy.md).
# Compose reads it to fill in ${...}, and passes it to Laravel. Never commit the real file.

# Where the demo lives, and the Traefik it sits behind
APP_HOST=kingboosting.dsalim.dev
IMAGE_TAG=latest
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

APP_NAME="King Boosting"
APP_ENV=production
APP_DEBUG=false
# docker run --rm ghcr.io/caddydz/kingboosting-app php artisan key:generate --show
APP_KEY=
APP_URL=https://kingboosting.dsalim.dev
FRONTEND_URL=https://kingboosting.dsalim.dev

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=kingboosting
DB_USERNAME=kingboosting
# openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# One origin (docs/adr/0001): host-only cookies, https only
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=kingboosting.dsalim.dev

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=database
CACHE_STORE=database

# The demo sends no real email: messages go to the log (docker compose logs app)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@kingboosting.test"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb: the key is public (the browser sends it), the secret signs Laravel's calls. openssl rand -hex 16 / 32
REVERB_APP_ID=kingboosting
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=kingboosting.dsalim.dev

# Stripe TEST keys only: the app refuses live keys. The webhook endpoint is https://<APP_HOST>/stripe/webhook,
# created in Stripe's test mode for payment_intent.succeeded and payment_intent.payment_failed.
STRIPE_KEY=pk_test_
STRIPE_SECRET=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# The demo accounts' password, shown on the login page, and the 04:00 UTC reset back to the seeded data
DEMO_PASSWORD=password
DEMO_RESET_NIGHTLY=true
