# Settings for compose.prod.yaml. Copy to .env.production (gitignored) and fill in.
# Compose also reads this file for ${...} substitution: export
# COMPOSE_ENV_FILES=.env.production or pass --env-file .env.production.

APP_NAME="King Boosting"
# Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# Public URL of the API and Nova admin; the storefront is built against it too
APP_URL=https://api.example.com
# Public URL of the storefront (Nova sends logged-out visitors there)
FRONTEND_URL=https://example.com

# The storefront logs in with Sanctum cookies, so both hosts share a parent domain
SANCTUM_STATEFUL_DOMAINS=example.com
SESSION_DOMAIN=.example.com
SESSION_SECURE_COOKIE=true

DB_DATABASE=kingboosting
DB_USERNAME=kingboosting
DB_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TO_ADDRESS=contact@example.com

# Broadcasting defaults to the null driver. Once the PUSHER_* keys are filled in:
# BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu

# STRIPE_KEY is the publishable key; it's also compiled into the storefront
STRIPE_KEY=
STRIPE_SECRET=

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
FRONTEND_SENTRY_DSN=

OWNER_NAME=Ked
ADMIN_NAME="${OWNER_NAME}"
ADMIN_EMAIL=admin@example.com
# Password of the admin account db:seed creates. Seeding fails without it
ADMIN_PASSWORD=

ACTIVITY_LOGGER_ENABLED=false

# Host ports, published on 127.0.0.1 for the TLS proxy
APP_PORT=8080
FRONTEND_PORT=3301
