# Build context for the PHP images (Dockerfile). Keep it small and free of secrets.

.git
.github
.idea
.vscode
**/.DS_Store

# Secrets and local config: production config comes from the environment
.env
.env.*
!.env.example
auth.json
storage/*.key

# Dependencies are installed inside the image
vendor
node_modules
**/node_modules

# The storefront has its own image (frontend/Dockerfile)
frontend

# Generated at runtime. bootstrap/cache was generated with dev packages and
# would break a --no-dev image if copied in.
bootstrap/cache/*.php
public/storage
public/hot
storage/api-docs
storage/debugbar
storage/logs/*
storage/app/public/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*

# Not needed at runtime
tests
phpunit.xml
.phpunit.result.cache
.php-cs-fixer.php
.php-cs-fixer.cache
_ide_helper.php
.phpstorm.meta.php
deploy.sh
README.md
Dockerfile
.dockerignore
compose*.yaml
